{
  "rules": {
    "index": {
      ".read": "auth != null",
      ".indexOn": [
        ".value"
      ],
      "$gid": {
        ".write": "auth != null && (!data.exists() || data.val() < now - 604800000)",
        ".validate": "newData.isNumber()"
      }
    },
    "games": {
      "$gid": {
        ".read": "auth != null && data.child('players/' + auth.uid).exists()",
        ".write": "auth != null && data.exists() && data.child('meta/createdAt').val() < now - 604800000 && !newData.exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('createdBy').val() === auth.uid)",
          ".validate": "newData.hasChildren(['createdBy', 'createdAt', 'n', 'status']) && newData.child('createdBy').val() === auth.uid && (newData.child('n').val() === 4 || newData.child('n').val() === 6)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('games/' + $gid + '/meta').exists()",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "seats": {
          "$seat": {
            ".write": "auth != null && root.child('games/' + $gid + '/players/' + auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid && root.child('games/' + $gid + '/meta/status').val() === 'lobby') || (data.val() === auth.uid && !newData.exists()) || (data.exists() && newData.val() === auth.uid && root.child('games/' + $gid + '/presence/' + data.val()).val() !== true))"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "state": {
          ".write": "auth != null && root.child('games/' + $gid + '/players/' + auth.uid).exists()",
          ".validate": "newData.child('v').isNumber() && (!data.exists() || newData.child('v').val() === data.child('v').val() + 1)"
        }
      }
    },
    "hands": {
      "$gid": {
        ".write": "auth != null && !newData.exists() && (!root.child('games/' + $gid).exists() || root.child('games/' + $gid + '/meta/createdAt').val() < now - 604800000)",
        "$seat": {
          ".read": "auth != null && root.child('games/' + $gid + '/seats/' + $seat).val() === auth.uid",
          ".write": "auth != null && root.child('games/' + $gid + '/players/' + auth.uid).exists()"
        }
      }
    },
    "decks": {
      "$gid": {
        ".read": "auth != null && root.child('games/' + $gid + '/players/' + auth.uid).exists()",
        ".write": "auth != null && (root.child('games/' + $gid + '/players/' + auth.uid).exists() || (!newData.exists() && (!root.child('games/' + $gid).exists() || root.child('games/' + $gid + '/meta/createdAt').val() < now - 604800000)))"
      }
    },
    "v2": {
      "index": {
        ".read": "auth != null",
        ".indexOn": [
          ".value"
        ],
        "$code": {
          ".write": "auth != null && (!data.exists() || data.val() < now - 604800000)",
          ".validate": "newData.isNumber()"
        }
      },
      "rooms": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && data.exists() && data.child('meta/createdAt').val() < now - 604800000 && !newData.exists()",
          "meta": {
            ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['host', 'createdAt', 'n', 'status']) && newData.child('host').val() === auth.uid && (newData.child('n').val() === 4 || newData.child('n').val() === 6) && (newData.child('status').val() === 'waiting' || newData.child('status').val() === 'countdown' || newData.child('status').val() === 'playing')"
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('v2/rooms/' + $code + '/meta').exists()",
              ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
            }
          },
          "seats": {
            "$seat": {
              ".write": "auth != null && root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid && root.child('v2/rooms/' + $code + '/meta/status').val() === 'waiting') || (data.val() === auth.uid && !newData.exists()) || (data.exists() && data.val() !== 'bot' && newData.val() === auth.uid && root.child('v2/rooms/' + $code + '/presence/' + data.val()).val() !== true) || (root.child('v2/rooms/' + $code + '/meta/host').val() === auth.uid && root.child('v2/rooms/' + $code + '/meta/status').val() === 'waiting' && ((!data.exists() && newData.val() === 'bot') || (data.val() === 'bot' && !newData.exists()))))"
            }
          },
          "presence": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "state": {
            ".write": "auth != null && root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "newData.child('v').isNumber() && (!data.exists() || newData.child('v').val() === data.child('v').val() + 1)"
          },
          "turnAt": {
            ".write": "auth != null && root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "emotes": {
            "$seat": {
              ".write": "auth != null && root.child('v2/rooms/' + $code + '/seats/' + $seat).val() === auth.uid",
              ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').isString() && newData.child('t').val().length <= 40 && newData.child('at').val() <= now"
            }
          }
        }
      },
      "hands": {
        "$code": {
          ".write": "auth != null && !newData.exists() && (!root.child('v2/rooms/' + $code).exists() || root.child('v2/rooms/' + $code + '/meta/createdAt').val() < now - 604800000)",
          "$seat": {
            ".read": "auth != null && (root.child('v2/rooms/' + $code + '/seats/' + $seat).val() === auth.uid || (root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists() && (root.child('v2/rooms/' + $code + '/seats/' + $seat).val() === 'bot' || root.child('v2/rooms/' + $code + '/presence/' + root.child('v2/rooms/' + $code + '/seats/' + $seat).val()).val() !== true)))",
            ".write": "auth != null && root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists()"
          }
        }
      },
      "decks": {
        "$code": {
          ".read": "auth != null && root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists()",
          ".write": "auth != null && (root.child('v2/rooms/' + $code + '/players/' + auth.uid).exists() || (!newData.exists() && (!root.child('v2/rooms/' + $code).exists() || root.child('v2/rooms/' + $code + '/meta/createdAt').val() < now - 604800000)))"
        }
      },
      "users": {
        ".read": "auth != null",
        ".indexOn": [
          "points"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nick', 'char', 'color']) && newData.child('nick').isString() && newData.child('nick').val().length <= 20 && (!newData.child('points').exists() || newData.child('points').isNumber()) && (!newData.child('city').exists() || (newData.child('city').isString() && newData.child('city').val().length <= 24))"
        }
      },
      "codes": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        }
      },
      "friends": {
        "$owner": {
          ".read": "auth != null && auth.uid === $owner",
          "$friend": {
            ".write": "auth != null && (auth.uid === $owner || auth.uid === $friend)",
            ".validate": "newData.val() === true"
          }
        }
      },
      "status": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['state', 'at']) && (newData.child('state').val() === 'online' || newData.child('state').val() === 'game' || newData.child('state').val() === 'offline')"
        }
      },
      "invites": {
        "$to": {
          ".read": "auth != null && auth.uid === $to",
          "$from": {
            ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists())) && (!newData.exists() || root.child('v2/friends/' + $to + '/' + $from).val() === true)",
            ".validate": "newData.hasChildren(['code', 'name', 'at']) && newData.child('code').isString() && newData.child('code').val().length === 4"
          }
        }
      },
      "chats": {
        "$key": {
          ".read": "auth != null && $key.contains(auth.uid)",
          "msgs": {
            "$id": {
              ".write": "auth != null && $key.contains(auth.uid) && !data.exists()",
              ".validate": "newData.hasChildren(['from', 't', 'at']) && newData.child('from').val() === auth.uid && newData.child('t').isString() && newData.child('t').val().length <= 300"
            }
          },
          "typing": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $key.contains(auth.uid)",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      },
      "leagues": {
        "$code": {
          ".read": "auth != null",
          "name": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "n": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.val() === 4 || newData.val() === 6"
          },
          "host": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
          },
          "createdAt": {
            ".write": "auth != null && !data.exists()"
          },
          "members": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 20"
            }
          },
          "seats": {
            "$seat": {
              ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
            }
          },
          "wins": {
            "$team": {
              ".write": "auth != null && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists()",
              ".validate": "(!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1)"
            }
          },
          "games": {
            "$key": {
              ".write": "auth != null && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists() && !data.exists()",
              ".validate": "newData.hasChildren(['winner', 'at']) && newData.child('winner').isNumber()"
            }
          },
          "variants": {
            ".write": "auth != null && !data.exists()"
          },
          "soiree": {
            ".write": "auth != null && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['id', 'at', 'by']) && newData.child('by').val() === auth.uid && newData.child('at').isNumber() && (!newData.child('place').exists() || (newData.child('place').isString() && newData.child('place').val().length <= 40)))"
          },
          "rsvp": {
            "$id": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists()",
                ".validate": "newData.val() === 'oui' || newData.val() === 'peut' || newData.val() === 'non'"
              }
            }
          },
          "offline": {
            "$id": {
              ".write": "auth != null && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists() && ((!data.exists() && newData.child('by').val() === auth.uid) || !newData.exists())",
              ".validate": "!newData.exists() || (newData.hasChildren(['winner', 'by', 'at', 'playedAt']) && newData.child('winner').isNumber() && newData.child('winner').val() >= 0 && newData.child('winner').val() < root.child('v2/leagues/' + $code + '/n').val() / 2 && newData.child('playedAt').isNumber())",
              "votes": {
                "$uid": {
                  ".write": "auth != null && auth.uid === $uid && root.child('v2/leagues/' + $code + '/members/' + auth.uid).exists()",
                  ".validate": "newData.val() === 'oui' || newData.val() === 'non'"
                }
              }
            }
          }
        }
      },
      "myLeagues": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
